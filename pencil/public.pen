                        {
                          "type": "text",
                          "id": "1dsJe",
                          "name": "Text",
                          "fill": "#475569ff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "嗨，我是雅婷！擁有超過 10 年的臨床牙體技術經驗，曾在大型教學醫院擔任主治技師。我深知許多初\n學者在面對複雜的牙齒型態時感到的挫折與迷惘。",
                          "lineHeight": 1.625,
                          "textAlignVertical": "middle",
                          "fontFamily": "Noto Sans TC",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
