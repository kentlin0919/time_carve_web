                                            {
                                              "type": "frame",
                                              "id": "hmN2N",
                                              "name": "Container",
                                              "width": "fill_container",
                                              "stroke": {
                                                "align": "inside",
                                                "thickness": 1
                                              },
                                              "layout": "vertical",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "Dzrc7",
                                                  "name": "Text",
                                                  "fill": "#475569ff",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "在本單元中，我們將深入探討犬齒的獨特解剖結構。犬\n齒位於牙弓的轉角處，對於支撐口角和撕裂食物起著至\n關重要的作用。",
                                                  "lineHeight": 1.5,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Noto Sans TC",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "Y8Gcm",
                                              "name": "Container",
                                              "width": "fill_container",
                                              "stroke": {
                                                "align": "inside",
                                                "thickness": 1
                                              },
                                              "layout": "vertical",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "NFUno",
                                                  "name": "Text",
                                                  "fill": "#475569ff",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "犬齒的牙冠厚實，擁有牙弓中最長的牙根，這使得它在\n口腔中非常穩固。我們將重點學習如何雕刻出其特有的\n單一尖頭（Cusp）以及唇側顯著的中心嵴（Labial\nRidge），這些特徵是決定犬齒美觀與功能的關鍵。請\n準備好您的蠟塊與雕刻刀，跟隨影片步驟進行操作。",
                                                  "lineHeight": 1.5,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Noto Sans TC",
                                                  "fontSize": 16,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            }
                                          ]
